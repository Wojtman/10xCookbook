---
import Layout from "./Layout.astro";

interface Props {
  title?: string;
}

const { title }: Props = Astro.props;
const pageTitle = title ? `${title} · 10xCookbook` : "10xCookbook";
---

<Layout title={pageTitle}>
  <div class="book-shell flex min-h-screen flex-col items-center justify-center gap-8 px-6 py-12">
    <div class="book-page-surface w-full max-w-4xl shadow-book">
      <div class="book-page-pane mx-auto w-full max-w-2xl px-8 py-10 md:px-12 md:py-12">
        <slot />
      </div>
    </div>
  </div>
</Layout>
