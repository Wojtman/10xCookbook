---
import Layout from "../../layouts/Layout.astro";
import { RecipeCreateView } from "../../components/recipes/create";

const searchParams = Astro.url.searchParams;
const cookbookId = searchParams.get("cookbookId");

const supabase = Astro.locals.supabase;
const {
  data: { session },
} = await supabase.auth.getSession();

const userId = session?.user?.id ?? null;
const anonymousSessionId = Astro.cookies.get("anonymousSessionId")?.value ?? null;

const analyticsSessionId = (() => {
  if (userId) {
    return userId;
  }

  if (anonymousSessionId) {
    return anonymousSessionId;
  }

  if (typeof globalThis !== "undefined") {
    const cryptoApi = globalThis.crypto as Crypto | undefined;
    if (cryptoApi && typeof cryptoApi.randomUUID === "function") {
      return cryptoApi.randomUUID();
    }
  }

  return `${Date.now()}-${Math.random().toString(16).slice(2)}`;
})();
---

<Layout title="Create Recipe">
  <RecipeCreateView
    client:load
    initialCookbookId={cookbookId}
    initialUserId={userId}
    initialSessionId={anonymousSessionId}
    initialAnalyticsSessionId={analyticsSessionId}
  />
</Layout>
