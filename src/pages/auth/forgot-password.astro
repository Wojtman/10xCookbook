---
import AuthLayout from "../../layouts/AuthLayout.astro";
import { ForgotPasswordForm } from "../../components/auth/ForgotPasswordForm";

export const prerender = false;

const prefillEmail = Astro.url.searchParams.get("email") ?? "";
---

<AuthLayout title="Reset Password">
  <section class="flex flex-col gap-8">
    <header class="book-wood-panel flex flex-col items-center gap-3 px-6 py-6 text-center shadow-book">
      <span class="book-burned-subtitle">Account recovery</span>
      <h1 class="book-burned-text text-3xl tracking-[0.26em]">Reset Password</h1>
      <p class="max-w-xl text-sm leading-relaxed text-ink-soft">
        Enter your email and we will send instructions to reset your password. For security, the response is identical
        whether an account exists or not.
      </p>
    </header>

    <ForgotPasswordForm client:load initialEmail={prefillEmail} />

    <nav class="flex flex-col gap-2 text-sm text-ink-soft md:flex-row md:items-center md:justify-between">
      <a href="/auth/login" class="font-semibold uppercase tracking-[0.18em] text-ink hover:text-ink-muted transition">
        Return to sign in
      </a>
      <a
        href="/auth/register"
        class="font-semibold uppercase tracking-[0.18em] text-ink hover:text-ink-muted transition"
      >
        Need an account? Register
      </a>
    </nav>
  </section>
</AuthLayout>
