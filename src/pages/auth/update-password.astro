---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { UpdatePasswordForm } from '../../components/auth/UpdatePasswordForm';

export const prerender = false;

const code = Astro.url.searchParams.get('code');
const accessToken = Astro.url.searchParams.get('access_token');
const hasToken = Boolean(code ?? accessToken);
---

<AuthLayout title="Update Password">
  <section class="flex flex-col gap-8">
    <header class="book-wood-panel flex flex-col items-center gap-3 px-6 py-6 text-center shadow-book">
      <span class="book-burned-subtitle">Set a new password</span>
      <h1 class="book-burned-text text-3xl tracking-[0.26em]">Update Password</h1>
      <p class="max-w-xl text-sm leading-relaxed text-ink-soft">
        Choose a fresh password for your account. Once complete, we will return you to your cookbook and
        sign in automatically.
      </p>
    </header>

    {
      hasToken
        ? null
        : (
          <div class="relative w-full overflow-hidden rounded-none border border-[rgba(143,58,32,0.45)] bg-[rgba(248,220,203,0.92)] px-4 py-3 text-sm text-[rgba(92,32,16,0.95)] shadow-[0_12px_16px_-14px_rgba(0,0,0,0.55)] backdrop-blur-sm">
            <div class="text-xs font-semibold uppercase tracking-[0.26em] text-[rgba(143,58,32,0.9)]">
              Reset link missing
            </div>
            <p class="mt-1 leading-relaxed">
              We could not detect a valid reset code in the URL. Double-check the email link or request a new
              password reset.
            </p>
          </div>
        )
    }

    <UpdatePasswordForm client:load />

    <nav class="flex flex-col gap-2 text-sm text-ink-soft md:flex-row md:items-center md:justify-between">
      <a
        href="/auth/login"
        class="font-semibold uppercase tracking-[0.18em] text-ink hover:text-ink-muted transition"
      >
        Return to sign in
      </a>
      <a
        href="/auth/forgot-password"
        class="font-semibold uppercase tracking-[0.18em] text-ink hover:text-ink-muted transition"
      >
        Request a new reset email
      </a>
    </nav>
  </section>
</AuthLayout>

